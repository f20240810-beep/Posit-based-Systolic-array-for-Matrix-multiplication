## =============================================================================
## power_saif_flow.tcl
##
## Vectorless power estimation (report_power with no SAIF) is a
## statistical guess based on default/assumed toggle rates - it's fine
## for a rough sanity check, but weak evidence in a report that claims
## to compare power across three architectures. A SAIF (Switching
## Activity Interchange Format) file, generated by actually SIMULATING
## the design with real test vectors and recording every signal's
## toggle activity, gives Vivado's power estimator the real switching
## behavior of the design instead of a guess - standard practice for a
## defensible power number.
##
## This is a TWO-STEP flow across two different Vivado tool contexts
## (simulation, then implementation) - can't be fully automated in one
## script since step 1 needs to actually run your testbench.
##
## ------------------------------------------------------------------
## STEP 1 - Generate the SAIF (run this DURING simulation)
## ------------------------------------------------------------------
## Simplest route (GUI): Simulation Settings -> Simulation tab ->
## check "Generate Switching Activity" -> set the SAIF output file
## path -> set "SAIF scope" to the DUT instance (e.g.
## tb_posit_systolic_top/dut) so you're not logging testbench-only
## signals -> run behavioral (or, for a more realistic number,
## post-implementation timing) simulation for enough cycles to cover
## a representative set of matrix multiplies (e.g. drive it with the
## same tb_posit_systolic_top.v 26-case test set already in this
## project, or a bigger sweep if you want more toggle coverage).
##
## Equivalent manual/Tcl route, run inside the XSIM Tcl console after
## the simulation is loaded:
##   open_saif "posit8_activity.saif"
##   log_saif [get_objects -r /tb_posit_systolic_top/dut/*]
##   run 5000ns   ;# or however long your test sequence needs
##   close_saif
##
## Do this once per variant (posit8_activity.saif, int8_activity.saif,
## fp16_activity.saif) using each variant's own testbench, so the
## comparison uses equivalent, representative switching activity for
## all three.
##
## ------------------------------------------------------------------
## STEP 2 - Read the SAIF back and report power (this part IS scripted
## below - edit SAIF_FILE and DUT_SCOPE, then source this file from
## the Tcl console of the IMPLEMENTED project)
## ------------------------------------------------------------------

set SAIF_FILE "posit8_activity.saif"   ;# from Step 1
set DUT_SCOPE ""                        ;# e.g. "tb_posit_systolic_top/dut" if
                                          ;# your SAIF's hierarchy needs stripping
                                          ;# to match the implemented netlist's
                                          ;# top-level scope - leave "" to try
                                          ;# a direct match first
set IMPL_RUN_NAME "impl_1"

if {[catch {current_design}]} {
    open_run $IMPL_RUN_NAME
}

if {$DUT_SCOPE eq ""} {
    read_saif $SAIF_FILE
} else {
    read_saif -strip_path $DUT_SCOPE $SAIF_FILE
}

report_power -file "report_power_saif.txt"

puts "SAIF-based power report written to report_power_saif.txt"
puts "Compare its total power / dynamic power against report_power_vectorless.txt"
puts "(from extract_reports.tcl) - report the SAIF-based number as your primary"
puts "figure and note the vectorless one only as a sanity-check baseline in your writeup."
